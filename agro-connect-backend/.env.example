# Agro Connect backend — environment variables.
# Copy this file to .env and edit as needed. Never commit the real .env.

# Used to sign access tokens (JWT). Change this to any long random string
# for anything beyond local testing.
SECRET_KEY=dev-only-secret-change-me-please-1234567890

# Where the SQLite database file is created (relative to where you run uvicorn).
DATABASE_URL=sqlite:///./agro_connect.db

# Must exactly match the URL your React frontend runs on (Vite default shown).
# This has to be an exact origin, not "*", because the frontend sends
# credentials (cookies) with its requests.
FRONTEND_ORIGIN=http://localhost:5173

# Access token lifetime, in minutes. Kept short on purpose — the frontend
# silently renews it via /auth/refresh using the longer-lived refresh cookie.
ACCESS_TOKEN_MINUTES=30

# Refresh cookie lifetime, in days.
REFRESH_TOKEN_DAYS=30
