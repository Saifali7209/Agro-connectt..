# Agro Connect — frontend environment.
# Copy to .env.local and edit. Only VITE_* vars reach the browser.
# NEVER put database URIs, JWT secrets or API keys in this file.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=20000
VITE_API_UPLOAD_TIMEOUT_MS=60000
VITE_API_WITH_CREDENTIALS=true

# true  -> marketplace-style screens fall back to demo content when the API is down
# false -> required for real deployments
VITE_USE_DEMO_DATA=true
